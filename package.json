{
  "name": "air-german-app",
  "version": "1.0.0",
  "description": "Air German Desktop App",
  "main": "main.js",
  "scripts": {
    "start": "concurrently \"npm run start:simbridge\" \"electron .\"",
    "start:simbridge": "node ./simbridge/index.js",
    "dist": "electron-builder"
  },
  "keywords": [],
  "author": "Air German",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.12.2",
    "bcryptjs": "^3.0.2",
    "discord-rpc": "^4.0.1",
    "electron-store": "^10.1.0",
    "express": "^5.1.0",
    "firebase": "^12.5.0",
    "node-simconnect": "^4.0.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "electron": "^38.1.2",
    "electron-builder": "^26.0.12",
    "nodemon": "^3.1.10"
  },
  "build": {
    "appId": "com.airgerman.app",
    "productName": "Air German App",
    "files": [
      "**/*",
      "!node_modules/*/{CHANGELOG.md,README.md,README,readme.md,readme}",
      "!**/.*",
      "!**/*.map"
    ],
    "directories": {
      "buildResources": "assets",
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/details/Air German Logo Black Background.png"
    }
  }
}
